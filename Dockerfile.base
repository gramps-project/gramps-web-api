# Build stage: compile the Python packages that have no binary wheels,
# so that the final image needs no compiler or development headers
FROM debian:trixie AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential pkg-config python3-dev python3-venv \
  libcairo2-dev libgirepository-2.0-dev libicu-dev \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /venv \
  && /venv/bin/pip wheel --no-cache-dir --wheel-dir /wheels PyGObject pycairo PyICU

FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
ENV GRAMPS_VERSION=60

WORKDIR /app

# install poppler (needed for PDF thumbnails)
# ffmpeg (needed for video thumbnails)
# postgresql client (needed for PostgreSQL backend)
# Noto fonts (needed to render non-Latin scripts in generated reports -
# without them, Pango has no glyphs and PDF output is garbled)
# libcairo, libgirepository and libicu are needed by the wheels from the build stage
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  fonts-dejavu-core fonts-noto-core fonts-noto-cjk \
  libcairo2 libcairo-gobject2 libgirepository-2.0-0 libicu76 \
  gir1.2-gtk-3.0 gir1.2-pango-1.0 \
  graphviz gir1.2-gexiv2-0.10 gir1.2-osmgpsmap-1.0 \
  locales gettext wget python3-venv \
  poppler-utils poppler-data ffmpeg libavcodec-extra \
  unzip \
  postgresql-client postgresql-client-common \
  tesseract-ocr \
  tesseract-ocr-osd \
  tesseract-ocr-ara \
  tesseract-ocr-bul \
  tesseract-ocr-bre \
  tesseract-ocr-cat \
  tesseract-ocr-ces \
  tesseract-ocr-dan \
  tesseract-ocr-deu \
  tesseract-ocr-ell \
  tesseract-ocr-eng \
  tesseract-ocr-epo \
  tesseract-ocr-spa \
  tesseract-ocr-fin \
  tesseract-ocr-fra \
  tesseract-ocr-gle \
  tesseract-ocr-heb \
  tesseract-ocr-hrv \
  tesseract-ocr-hun \
  tesseract-ocr-isl \
  tesseract-ocr-ind \
  tesseract-ocr-ita \
  tesseract-ocr-jpn \
  tesseract-ocr-kor \
  tesseract-ocr-lit \
  tesseract-ocr-lav \
  tesseract-ocr-mkd \
  tesseract-ocr-nor \
  tesseract-ocr-nld \
  tesseract-ocr-pol \
  tesseract-ocr-por \
  tesseract-ocr-ron \
  tesseract-ocr-rus \
  tesseract-ocr-slk \
  tesseract-ocr-slv \
  tesseract-ocr-sqi \
  tesseract-ocr-srp \
  tesseract-ocr-swe \
  tesseract-ocr-tam \
  tesseract-ocr-tur \
  tesseract-ocr-ukr \
  tesseract-ocr-vie \
  tesseract-ocr-chi-sim \
  tesseract-ocr-chi-tra \
  && localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8 \
  && rm -rf /var/lib/apt/lists/*
ENV LANGUAGE=en_US.utf8
ENV LANG=en_US.utf8
ENV LC_ALL=en_US.utf8

# limit OpenMP and BLAS (NumPy, OpenCV) to 1 thread
ENV OMP_NUM_THREADS=1

# Use a venv so pip can manage packages without conflicting with Debian-installed ones
RUN python3 -m venv /venv --system-site-packages
ENV PATH="/venv/bin:$PATH"

# install wheel first to enable binary packages for all pip installs
RUN pip install --no-cache-dir wheel

# install gunicorn
RUN pip install --no-cache-dir gunicorn

# install Pillow from PyPI (PyPI wheel includes AVIF support, unlike the apt package)
RUN pip install --no-cache-dir Pillow

# Install the wheels compiled in the build stage
RUN --mount=type=bind,from=builder,source=/wheels,target=/wheels \
  pip install --no-cache-dir /wheels/*.whl

# Install opencv
# keep in sync with the "face" extra in pyproject.toml
RUN pip install --no-cache-dir 'opencv-python-headless>=4.8,<6'

# Install AI dependencies
RUN pip install --no-cache-dir 'pydantic-ai[openai]>=1.0.0,<2.0.0'

# install Gramps addons
RUN mkdir -p /root/gramps/gramps$GRAMPS_VERSION/plugins && \
    wget https://github.com/gramps-project/addons/archive/refs/heads/master.zip && \
    for addon in PostgreSQL SharedPostgreSQL FilterRules JSON; do \
        unzip -p master.zip addons-master/gramps$GRAMPS_VERSION/download/$addon.addon.tgz | \
        tar -xvz -C /root/gramps/gramps$GRAMPS_VERSION/plugins; \
    done && \
    rm master.zip
